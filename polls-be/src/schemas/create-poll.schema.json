{
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "minLength": 1
    },
    "isAiGenerated": {
      "type": "boolean"
    },
    "deliveryType": {
      "type": "string",
      "enum": ["IMMEDIATE", "SCHEDULED"]
    },
    "userPrompt": {
      "type": ["string", "null"]
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "isAiSuggested": {
            "type": "boolean"
          },
          "multipleResponses": {
            "type": "boolean"
          },
          "pollOptions": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "displayOrder": {
                  "type": "number"
                }
              },
              "required": ["title", "displayOrder"]
            }
          }
        },
        "required": ["title", "isAiSuggested", "multipleResponses", "pollOptions"]
      }
    },
    "audienceIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "type": {
      "type": "string",
      "enum": ["AUDIENCE"]
    },
    "settings": {
      "type": "object",
      "properties": {
        "isAnonymous": {
          "type": "boolean"
        },
        "allowResults": {
          "type": "boolean"
        },
        "allowResultsBeforeResponse": {
          "type": "boolean"
        },
        "startsAt": {
          "type": "string"
        },
        "endsAt": {
          "type": "string"
        },
        "participationWindowDateType": {
          "type": ["string", "null"],
          "enum": ["ONE_DAY", "TWO_DAYS", "ONE_WEEK", "TWO_WEEKS", "CUSTOM", null],
          "default": "ONE_WEEK"
        }
      },
      "required": ["isAnonymous", "allowResults", "allowResultsBeforeResponse", "startsAt", "endsAt", "participationWindowDateType"]
    }
  },
  "required": ["questions", "audienceIds", "type", "settings", "isAiGenerated", "deliveryType"]
}
